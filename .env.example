# Шаблон окружения. Скопировать в .env (локально) или задать в окружении
# сервиса (Render). РЕАЛЬНЫЕ значения сюда НЕ писать — это пример.

# ===== Django core =====
DJANGO_SECRET_KEY=            # ОБЯЗАТЕЛЬНО в проде. Сгенерировать новый случайный.
DJANGO_DEBUG=False           # В проде всегда False
DJANGO_ALLOWED_HOSTS=montenegro-8y6i.onrender.com,raccoon.uz,www.raccoon.uz,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://montenegro-8y6i.onrender.com,https://raccoon.uz,https://www.raccoon.uz

# ===== База данных =====
DATABASE_URL=                # Postgres URL (Render подставляет автоматически)

# ===== Click =====
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=            # server-only
CLICK_SUCCESS_URL=
CLICK_FAIL_URL=

# ===== Payme (Paycom) =====
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=           # server-only
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
PAYME_ACCOUNT_FIELD=order_id
PAYME_SUCCESS_URL=
PAYME_FAIL_URL=

# ===== Онлайн-оплата TTL =====
ORDER_AWAITING_PAYMENT_TTL_HOURS=24

# ===== Eskiz (SMS / OTP) =====
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
ESKIZ_OTP_TEMPLATE=Kod: {code}
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
OTP_EXPOSE_CODE_FOR_TESTING=False   # В проде ОБЯЗАТЕЛЬНО False
OTP_CODE_TTL_SECONDS=300
OTP_CODE_LENGTH=4

# ===== Telegram (уведомления о заказах) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

