{% load i18n %}<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% trans "Тип бизнеса" %} · ЧекМейт</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
:root{--surface:#f7f8fa;--surface-raised:#fff;--surface-sunken:#f1f3f7;--border:#e5e7eb;--border-strong:#d1d5db;
--ink:#111827;--ink-muted:#667085;--ink-subtle:#98a2b3;--primary:#123b7a;--primary-hover:#0d2d5f;--primary-soft:#e7edf7;--on-primary:#fff;
--cat-blue:#2e6be6;--cat-violet:#7a5af8;--cat-amber:#e0a42b;--danger:#d92d20;--danger-soft:#fdecec;
--radius-md:8px;--radius-lg:12px;--radius-pill:999px;--shadow-sm:0 1px 2px rgba(16,24,40,.06),0 1px 3px rgba(16,24,40,.04);--shadow-md:0 4px 12px rgba(16,24,40,.10);
--font-sans:"Inter",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--surface:#0e1420;--surface-raised:#161d2b;--surface-sunken:#1b2433;--border:#28313f;--border-strong:#3a4557;--ink:#e9eef6;--ink-muted:#9da9bd;--ink-subtle:#707e95;--primary:#5b8def;--primary-hover:#7aa4f2;--primary-soft:#1a2b49;--on-primary:#0b1220;--cat-blue:#6aa0f5;--cat-violet:#a892fb;--cat-amber:#f2c25c;}}
*{box-sizing:border-box;}
body{font-family:var(--font-sans);background:var(--surface);color:var(--ink);margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;font-size:14px;}
.wrap{width:100%;max-width:880px;}
.top{display:flex;align-items:center;gap:10px;margin-bottom:6px;}
.brand{font-size:19px;font-weight:700;letter-spacing:-.01em;}
.tag{font-size:11px;font-weight:600;color:var(--primary);background:var(--primary-soft);padding:3px 9px;border-radius:var(--radius-pill);}
h1{font-size:24px;font-weight:700;letter-spacing:-.02em;margin:18px 0 4px;}
.lead{color:var(--ink-muted);margin:0 0 22px;font-size:15px;}
.err{background:var(--danger-soft);color:var(--danger);border-radius:var(--radius-md);padding:10px 14px;margin:0 0 16px;font-weight:600;}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;}
.card{position:relative;display:block;background:var(--surface-raised);border:1.5px solid var(--border);border-radius:var(--radius-lg);padding:20px 18px 18px;cursor:pointer;transition:.15s ease;box-shadow:var(--shadow-sm);}
.card:hover{border-color:var(--border-strong);box-shadow:var(--shadow-md);transform:translateY(-2px);}
.card input{position:absolute;opacity:0;pointer-events:none;}
.card:has(input:checked){border-color:var(--primary);box-shadow:0 0 0 3px var(--primary-soft),var(--shadow-md);}
.ic{width:46px;height:46px;border-radius:var(--radius-md);display:flex;align-items:center;justify-content:center;margin-bottom:10px;}
.ic svg{width:24px;height:24px;stroke-width:2;}
.c-retail .ic{background:color-mix(in srgb,var(--cat-blue) 14%,transparent);color:var(--cat-blue);}
.c-rest .ic{background:color-mix(in srgb,var(--cat-amber) 16%,transparent);color:var(--cat-amber);}
.c-serv .ic{background:color-mix(in srgb,var(--cat-violet) 14%,transparent);color:var(--cat-violet);}
.c-title{font-size:16px;font-weight:700;margin-bottom:6px;}
.c-desc{color:var(--ink-muted);font-size:13px;line-height:1.45;}
.c-ex{margin-top:10px;display:flex;flex-wrap:wrap;gap:5px;}
.chip{font-size:11px;font-weight:500;color:var(--ink-muted);background:var(--surface-sunken);border:1px solid var(--border);padding:2px 8px;border-radius:var(--radius-pill);}
.check{position:absolute;top:14px;right:14px;width:20px;height:20px;border-radius:50%;border:1.5px solid var(--border-strong);display:flex;align-items:center;justify-content:center;transition:.15s;}
.card:has(input:checked) .check{background:var(--primary);border-color:var(--primary);color:#fff;}
.check svg{width:12px;height:12px;opacity:0;}
.card:has(input:checked) .check svg{opacity:1;}
.foot{margin-top:24px;display:flex;align-items:center;gap:14px;}
.hint{color:var(--ink-subtle);font-size:13px;}
.btn{margin-left:auto;background:var(--primary);color:var(--on-primary);border:0;height:46px;padding:0 26px;border-radius:var(--radius-md);font-weight:600;font-size:15px;cursor:pointer;font-family:inherit;transition:.15s;}
.btn:hover{background:var(--primary-hover);}
.btn:disabled{opacity:.5;cursor:not-allowed;}
@media(max-width:720px){.grid{grid-template-columns:1fr;}}
</style>
</head>
<body>
<div class="wrap">
  <div class="top"><span class="brand">ЧекМейт</span><span class="tag">{% trans "касса" %}</span></div>
  <h1>{% trans "Какой у вас бизнес?" %}</h1>
  <p class="lead">{% trans "Мы настроим кассу под ваш профиль. Это можно изменить позже." %}</p>
  {% if error %}<div class="err">{{ error }}</div>{% endif %}
  <form method="post" action="/start/">
    {% csrf_token %}
    <div class="grid">
      <label class="card c-retail">
        <input type="radio" name="business_type" value="retail">
        <span class="check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
        <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l1-5h16l1 5"/><path d="M4 9v11h16V9"/><path d="M9 20v-6h6v6"/></svg></span>
        <div class="c-title">{% trans "Магазин" %}</div>
        <div class="c-desc">{% trans "Розница и опт: продажа по штрихкоду, весовой товар, склад и партии." %}</div>
        <div class="c-ex"><span class="chip">{% trans "Продукты" %}</span><span class="chip">{% trans "Одежда" %}</span><span class="chip">{% trans "Аптека" %}</span></div>
      </label>
      <label class="card c-rest">
        <input type="radio" name="business_type" value="restaurant">
        <span class="check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
        <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M4 3v7a3 3 0 006 0V3"/><path d="M7 10v11"/><path d="M17 3c-1.5 1-2 3-2 6s.5 4 2 5v7"/></svg></span>
        <div class="c-title">{% trans "Кафе / ресторан" %}</div>
        <div class="c-desc">{% trans "Зал и столы, кухня (KDS), техкарты и FoodCost, доставка и агрегаторы." %}</div>
        <div class="c-ex"><span class="chip">{% trans "Кафе" %}</span><span class="chip">{% trans "Ресторан" %}</span><span class="chip">{% trans "Доставка" %}</span></div>
      </label>
      <label class="card c-serv">
        <input type="radio" name="business_type" value="services">
        <span class="check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
        <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></span>
        <div class="c-title">{% trans "Услуги" %}</div>
        <div class="c-desc">{% trans "Запись и календарь, мастера и расписание, абонементы и комиссии." %}</div>
        <div class="c-ex"><span class="chip">{% trans "Салон" %}</span><span class="chip">{% trans "Студия" %}</span><span class="chip">{% trans "Автосервис" %}</span></div>
      </label>
    </div>
    <div class="foot">
      <span class="hint">{% trans "Выберите тип, чтобы продолжить" %}</span>
      <button class="btn" type="submit" id="go" disabled>{% trans "Продолжить" %} →</button>
    </div>
  </form>
</div>
<script>
document.querySelectorAll('input[name=business_type]').forEach(function(r){
  r.addEventListener('change',function(){document.getElementById('go').disabled=false;});
});
</script>
</body>
</html>
