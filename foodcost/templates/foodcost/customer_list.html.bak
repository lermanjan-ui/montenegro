{% extends "foodcost/base.html" %}

{% block title %}Клиенты{% endblock %}

{% block content %}

<!-- CSS встроен inline (без staticfiles). Дизайн-система FoodCost UI Kit v2:
     токены, .fc-card, .fc-btn, .fc-input/.fc-select, .fc-badge, таблица.
     Добавлены .fc-kpi-*, .fc-chip, сортируемые заголовки и сетка таблицы. -->
<style>
:root{
    --fc-bg:#F5F7FA; --fc-card:#FFFFFF; --fc-card-soft:#F9FAFB;
    --fc-border:#E5E7EB; --fc-border-soft:#F3F4F6;
    --fc-text:#111827; --fc-muted:#6B7280; --fc-muted-soft:#9CA3AF;
    --fc-green:#16A34A; --fc-green-hover:#15803D; --fc-green-soft:#DCFCE7; --fc-green-text:#166534;
    --fc-warning:#F59E0B; --fc-warning-soft:#FEF3C7; --fc-warning-text:#92400E;
    --fc-danger:#EF4444; --fc-danger-soft:#FEE2E2; --fc-danger-text:#991B1B;
    --fc-info:#3B82F6; --fc-info-soft:#DBEAFE; --fc-info-text:#1E40AF;
    --fc-radius-card:12px; --fc-radius-input:10px; --fc-radius-pill:999px;
    --fc-shadow:0 1px 2px rgba(0,0,0,.04), 0 4px 12px rgba(0,0,0,.04);
    --fc-font:"Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.fc-scope{ background:var(--fc-bg); color:var(--fc-text); font-family:var(--fc-font); min-height:100vh; }
.fc-scope *{ box-sizing:border-box; }
.fc-page{ max-width:1280px; margin:0 auto; padding:24px; }

.fc-breadcrumbs{ display:flex; align-items:center; gap:8px; font-size:13px; color:var(--fc-muted); margin-bottom:16px; }
.fc-breadcrumbs a{ color:var(--fc-muted); text-decoration:none; }
.fc-breadcrumbs a:hover{ color:var(--fc-text); }
.fc-breadcrumbs .sep{ opacity:.5; }
.fc-breadcrumbs .current{ color:var(--fc-text); font-weight:600; }

.fc-page-head{ display:flex; justify-content:space-between; align-items:flex-start; gap:16px; margin-bottom:24px; }
.fc-page-head h1{ margin:0 0 8px; font-size:32px; font-weight:600; letter-spacing:-0.02em; }
.fc-page-head .muted{ margin:0; color:var(--fc-muted); font-size:14px; line-height:1.5; }

.fc-card{ background:var(--fc-card); border:1px solid var(--fc-border); border-radius:var(--fc-radius-card); box-shadow:var(--fc-shadow); padding:24px; margin-bottom:16px; }
.fc-card-head{ display:flex; justify-content:space-between; align-items:center; gap:16px; margin-bottom:16px; flex-wrap:wrap; }
.fc-card-head h2{ margin:0; font-size:22px; font-weight:600; letter-spacing:-0.01em; }
.fc-card-head .muted{ margin:0; color:var(--fc-muted); font-size:13px; }

.fc-btn{ display:inline-flex; align-items:center; justify-content:center; gap:8px; height:40px; padding:0 16px; border-radius:var(--fc-radius-input); border:1px solid transparent; font-family:inherit; font-size:14px; font-weight:600; cursor:pointer; text-decoration:none; transition:background-color .12s,border-color .12s,color .12s; white-space:nowrap; }
.fc-btn-primary{ background:var(--fc-green); color:#fff; }
.fc-btn-primary:hover{ background:var(--fc-green-hover); }
.fc-btn-secondary{ background:var(--fc-card); color:var(--fc-text); border-color:var(--fc-border); }
.fc-btn-secondary:hover{ border-color:var(--fc-text); }
.fc-btn-sm{ height:32px; padding:0 12px; font-size:13px; }

.fc-input,.fc-select{ height:40px; padding:0 12px; background:var(--fc-card); border:1px solid var(--fc-border); border-radius:var(--fc-radius-input); font-family:inherit; font-size:14px; color:var(--fc-text); transition:border-color .12s,box-shadow .12s; width:100%; }
.fc-input:focus,.fc-select:focus{ outline:none; border-color:var(--fc-green); box-shadow:0 0 0 3px rgba(22,163,74,.12); }
.fc-input::placeholder{ color:var(--fc-muted-soft); }
.fc-select{ appearance:none; -webkit-appearance:none; background-image:url("data:image/svg+xml;utf8,<svg width='12' height='12' viewBox='0 0 12 12' fill='none' xmlns='http://www.w3.org/2000/svg'><path d='M3 4.5L6 7.5L9 4.5' stroke='%236B7280' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/></svg>"); background-repeat:no-repeat; background-position:right 12px center; padding-right:32px; cursor:pointer; }
.fc-label{ font-size:12px; font-weight:600; color:var(--fc-muted); margin-bottom:6px; display:block; }

.fc-badge{ display:inline-flex; align-items:center; gap:4px; padding:3px 10px; border-radius:var(--fc-radius-pill); font-size:12px; font-weight:600; line-height:1.4; white-space:nowrap; }
.fc-badge-green{ background:var(--fc-green-soft); color:var(--fc-green-text); }
.fc-badge-amber{ background:var(--fc-warning-soft); color:var(--fc-warning-text); }
.fc-badge-red{ background:var(--fc-danger-soft); color:var(--fc-danger-text); }
.fc-badge-blue{ background:var(--fc-info-soft); color:var(--fc-info-text); }
.fc-badge-gray{ background:var(--fc-border-soft); color:var(--fc-muted); }

.fc-kpi-grid{ display:grid; grid-template-columns:repeat(6,1fr); gap:12px; margin-bottom:16px; }
.fc-kpi-card{ background:var(--fc-card); border:1px solid var(--fc-border); border-radius:var(--fc-radius-card); box-shadow:var(--fc-shadow); padding:16px 18px; min-height:104px; display:flex; flex-direction:column; justify-content:center; }
.fc-kpi-label{ font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:.04em; color:var(--fc-muted); margin-bottom:8px; }
.fc-kpi-value{ font-size:24px; font-weight:700; letter-spacing:-0.01em; font-variant-numeric:tabular-nums; }
.fc-kpi-value.is-danger{ color:var(--fc-danger-text); }
.fc-kpi-value.is-green{ color:var(--fc-green-text); }

.fc-filter-form{ display:grid; grid-template-columns:2fr 1fr 1fr 1fr 1fr 1fr; gap:12px; align-items:end; }
.fc-filter-actions{ display:flex; gap:8px; margin-top:16px; grid-column:1 / -1; }

.fc-chips{ display:flex; flex-wrap:wrap; gap:8px; margin-top:14px; }
.fc-chip{ display:inline-flex; align-items:center; gap:6px; padding:6px 10px; border-radius:var(--fc-radius-pill); background:var(--fc-card-soft); border:1px solid var(--fc-border); font-size:13px; font-weight:600; color:var(--fc-text); text-decoration:none; }
.fc-chip:hover{ border-color:var(--fc-danger); color:var(--fc-danger); }
.fc-chip .x{ font-size:14px; line-height:1; opacity:.6; }

.fc-table{ width:100%; border:1px solid var(--fc-border); border-radius:var(--fc-radius-card); background:var(--fc-card); overflow:hidden; }
.cust-head,.cust-row{ display:grid; grid-template-columns: minmax(150px,1.7fr) 1.1fr 88px 1fr 1fr 1fr 1.2fr 1fr; gap:14px; align-items:center; padding:12px 18px; }
.cust-head{ background:var(--fc-card-soft); border-bottom:1px solid var(--fc-border); font-size:12px; font-weight:600; color:var(--fc-muted); text-transform:uppercase; letter-spacing:.04em; }
.cust-head a{ color:inherit; text-decoration:none; display:inline-flex; align-items:center; gap:4px; }
.cust-head a:hover{ color:var(--fc-text); }
.cust-head .num{ justify-content:flex-end; text-align:right; }
.cust-row{ border-bottom:1px solid var(--fc-border-soft); transition:background-color .1s; min-height:56px; cursor:pointer; }
.cust-row:last-child{ border-bottom:0; }
.cust-row:hover{ background:var(--fc-card-soft); }
.cust-name{ font-weight:600; font-size:15px; color:var(--fc-text); text-decoration:none; }
.cust-name:hover{ color:var(--fc-green-text); }
.cust-phone{ color:var(--fc-muted); font-size:14px; }
.cust-num{ display:block; font-weight:600; font-variant-numeric:tabular-nums; color:var(--fc-text); text-align:right; }
.cust-num.muted{ color:var(--fc-muted-soft); font-weight:500; }
.cust-num.is-zero{ color:var(--fc-danger-text); }
.cust-money{ color:var(--fc-green-text); font-weight:700; }
.cust-sources{ display:flex; flex-wrap:wrap; gap:4px; }

.fc-pagination{ display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:16px; flex-wrap:wrap; }
.fc-pagination .info{ color:var(--fc-muted); font-size:13px; }
.fc-pagination .pages{ display:flex; gap:8px; align-items:center; }
.fc-pagination .disabled{ opacity:.4; pointer-events:none; }

.fc-empty{ text-align:center; padding:48px 16px; }
.fc-empty-title{ font-size:16px; font-weight:600; color:var(--fc-text); margin-bottom:6px; }
.fc-empty-sub{ font-size:14px; color:var(--fc-muted); }

@media (max-width:1080px){
    .fc-kpi-grid{ grid-template-columns:repeat(3,1fr); }
    .fc-filter-form{ grid-template-columns:1fr 1fr 1fr; }
}
@media (max-width:720px){
    .fc-page{ padding:16px; }
    .fc-kpi-grid{ grid-template-columns:repeat(2,1fr); }
    .fc-filter-form{ grid-template-columns:1fr 1fr; }
    .cust-head{ display:none; }
    .cust-row{ grid-template-columns:1fr 1fr; gap:6px 14px; padding:16px 18px; }
    .cust-row > div{ text-align:left !important; }
    .cust-num,.cust-money{ text-align:left; }
    .cust-row > div::before{ content:attr(data-label); display:block; font-size:10px; text-transform:uppercase; letter-spacing:.04em; color:var(--fc-muted-soft); font-weight:600; margin-bottom:2px; }
    .cust-row > .cust-cell-name{ grid-column:1 / -1; }
    .cust-row > .cust-cell-name::before{ content:none; }
}
</style>

<div class="fc-scope">
<div class="fc-page">

    <nav class="fc-breadcrumbs" aria-label="Breadcrumbs">
        <a href="/c/{{ country.slug }}/">Главная</a>
        <span class="sep">›</span>
        <span class="current">Клиенты</span>
    </nav>

    <div class="fc-page-head">
        <div>
            <h1>Клиенты</h1>
            <p class="muted">База клиентов: заказы с сайта и импорт из Tilda. Сводка, фильтры и история по каждому клиенту.</p>
        </div>
        <button type="button" class="fc-btn fc-btn-primary" onclick="toggleNewCust()">+ Новый клиент</button>
    </div>

    <div class="fc-card" id="newCustCard" style="display:none;">
        <div class="fc-card-head"><h2>Новый клиент</h2></div>
        <form method="post" action="/c/{{ country.slug }}/customers/">
            {% csrf_token %}
            <input type="hidden" name="action" value="create_customer">
            <div class="fc-filter-form">
                <div>
                    <label class="fc-label">Имя / название *</label>
                    <input class="fc-input" type="text" name="name" placeholder="Имя или ООО «…»" required>
                </div>
                <div>
                    <label class="fc-label">Телефон</label>
                    <input class="fc-input" type="text" name="phone" placeholder="+998…">
                </div>
                <div style="display:flex;align-items:flex-end;">
                    <label style="display:flex;align-items:center;gap:8px;font-weight:600;font-size:14px;cursor:pointer;">
                        <input type="checkbox" name="is_corporate"> Корпоративный
                    </label>
                </div>
                <div style="display:flex;align-items:flex-end;gap:8px;">
                    <button type="submit" class="fc-btn fc-btn-primary">Создать и открыть</button>
                    <button type="button" class="fc-btn fc-btn-secondary" onclick="toggleNewCust()">Отмена</button>
                </div>
            </div>
        </form>
        <p class="muted" style="font-size:13px;margin:12px 0 0;">Клиент для заказов не через сайт (по телефону, самовывоз и т.п.). Если клиент с таким телефоном уже есть — откроется его карточка, без дубля.</p>
    </div>

    <div class="fc-kpi-grid">
        <div class="fc-kpi-card"><div class="fc-kpi-label">Всего клиентов</div><div class="fc-kpi-value">{{ kpis.total }}</div></div>
        <div class="fc-kpi-card"><div class="fc-kpi-label">Новых за 30 дней</div><div class="fc-kpi-value">{{ kpis.new_month }}</div></div>
        <div class="fc-kpi-card"><div class="fc-kpi-label">С повторными (2+)</div><div class="fc-kpi-value is-green">{{ kpis.repeat }}</div></div>
        <div class="fc-kpi-card"><div class="fc-kpi-label">VIP (5+ заказов)</div><div class="fc-kpi-value is-green">{{ kpis.vip }}</div></div>
        <div class="fc-kpi-card"><div class="fc-kpi-label">Средний чек</div><div class="fc-kpi-value">{{ kpis.avg_check }}</div></div>
        <div class="fc-kpi-card"><div class="fc-kpi-label">Проблемных</div><div class="fc-kpi-value is-danger">{{ kpis.problematic }}</div></div>
    </div>

    <div class="fc-card">
        <form method="get" class="fc-filter-form">
            <div>
                <label class="fc-label">Поиск</label>
                <input class="fc-input" type="text" name="search" value="{{ search }}" placeholder="Имя или телефон">
            </div>
            <div>
                <label class="fc-label">Период</label>
                <select class="fc-select" name="period">
                    <option value="all"     {% if period == "all" %}selected{% endif %}>Все время</option>
                    <option value="month"   {% if period == "month" %}selected{% endif %}>Месяц</option>
                    <option value="quarter" {% if period == "quarter" %}selected{% endif %}>Квартал</option>
                    <option value="year"    {% if period == "year" %}selected{% endif %}>Год</option>
                </select>
            </div>
            <div>
                <label class="fc-label">Статус</label>
                <select class="fc-select" name="status">
                    <option value="all"         {% if status == "all" %}selected{% endif %}>Все</option>
                    <option value="regular"     {% if status == "regular" %}selected{% endif %}>Постоянный</option>
                    <option value="problematic" {% if status == "problematic" %}selected{% endif %}>Проблемный</option>
                    <option value="blocked"     {% if status == "blocked" %}selected{% endif %}>Отказ в доставке</option>
                    <option value="normal"      {% if status == "normal" %}selected{% endif %}>Без флага</option>
                </select>
            </div>
            <div>
                <label class="fc-label">Заказов</label>
                <select class="fc-select" name="min_orders">
                    <option value="all"  {% if min_orders == "all" %}selected{% endif %}>Любое</option>
                    <option value="none" {% if min_orders == "none" %}selected{% endif %}>Без заказов</option>
                    <option value="1"    {% if min_orders == "1" %}selected{% endif %}>1+</option>
                    <option value="5"    {% if min_orders == "5" %}selected{% endif %}>5+ (постоянные)</option>
                </select>
            </div>
            <div>
                <label class="fc-label">Источник</label>
                <select class="fc-select" name="source">
                    <option value="all"   {% if source == "all" %}selected{% endif %}>Все</option>
                    <option value="site"  {% if source == "site" %}selected{% endif %}>Сайт</option>
                    <option value="tilda" {% if source == "tilda" %}selected{% endif %}>Tilda</option>
                </select>
            </div>
            <div>
                <label class="fc-label">По сумме</label>
                <select class="fc-select" name="amount">
                    <option value="all"   {% if amount == "all" %}selected{% endif %}>Все</option>
                    <option value="top50" {% if amount == "top50" %}selected{% endif %}>Топ-50 по тратам</option>
                </select>
            </div>
            <div>
                <label class="fc-label">Обеды</label>
                <select class="fc-select" name="lunches">
                    <option value="all" {% if lunches == "all" %}selected{% endif %}>Все</option>
                    <option value="yes" {% if lunches == "yes" %}selected{% endif %}>Заказывал обеды</option>
                </select>
            </div>

            <input type="hidden" name="sort" value="{{ sort }}">
            <input type="hidden" name="per_page" value="{{ per_page }}">

            <div class="fc-filter-actions">
                <button type="submit" class="fc-btn fc-btn-primary">Применить</button>
                <a class="fc-btn fc-btn-secondary" href="{{ reset_url }}">Сбросить</a>
            </div>
        </form>

        {% if chips %}
            <div class="fc-chips">
                {% for chip in chips %}
                    <a class="fc-chip" href="{{ chip.url }}">{{ chip.label }} <span class="x">✕</span></a>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <div class="fc-card">
        <div class="fc-card-head">
            <div>
                <h2>Список клиентов</h2>
                <p class="muted">
                    Показано {{ page_obj.start_index }}–{{ page_obj.end_index }} из {{ page_obj.paginator.count }}
                    · <a href="{{ sort_links.reg.url }}" style="color:var(--fc-muted);font-weight:600;">по дате регистрации {{ sort_links.reg.arrow }}</a>
                </p>
            </div>
            <form method="get" style="display:flex;align-items:center;gap:8px;">
                {% if search %}<input type="hidden" name="search" value="{{ search }}">{% endif %}
                <input type="hidden" name="period" value="{{ period }}">
                <input type="hidden" name="status" value="{{ status }}">
                <input type="hidden" name="min_orders" value="{{ min_orders }}">
                <input type="hidden" name="source" value="{{ source }}">
                <input type="hidden" name="amount" value="{{ amount }}">
                <input type="hidden" name="lunches" value="{{ lunches }}">
                <input type="hidden" name="sort" value="{{ sort }}">
                <label class="fc-label" style="margin:0;">На странице</label>
                <select class="fc-select" name="per_page" style="width:auto;" onchange="this.form.submit()">
                    <option value="25"  {% if per_page == 25 %}selected{% endif %}>25</option>
                    <option value="50"  {% if per_page == 50 %}selected{% endif %}>50</option>
                    <option value="100" {% if per_page == 100 %}selected{% endif %}>100</option>
                </select>
            </form>
        </div>

        <div class="fc-table">
            <div class="cust-head">
                <div><a href="{{ sort_links.name.url }}">Клиент {{ sort_links.name.arrow }}</a></div>
                <div>Телефон</div>
                <div class="num"><a href="{{ sort_links.orders.url }}">Заказов {{ sort_links.orders.arrow }}</a></div>
                <div class="num"><a href="{{ sort_links.spent.url }}">Сумма {{ sort_links.spent.arrow }}</a></div>
                <div class="num">Ср. чек</div>
                <div><a href="{{ sort_links.last.url }}">Последний {{ sort_links.last.arrow }}</a></div>
                <div>Статус</div>
                <div>Источник</div>
            </div>

            {% for row in rows %}
                <div class="cust-row" onclick="window.location='/c/{{ country.slug }}/customers/{{ row.id }}/'">
                    <div class="cust-cell-name">
                        <a class="cust-name" href="/c/{{ country.slug }}/customers/{{ row.id }}/" onclick="event.stopPropagation();">{{ row.name }}</a>
                    </div>
                    <div data-label="Телефон" class="cust-phone">{{ row.phone }}</div>
                    <div data-label="Заказов"><span class="cust-num{% if not row.orders_count %} is-zero{% endif %}">{{ row.orders_count }}</span></div>
                    <div data-label="Сумма"><span class="cust-num cust-money">{{ row.total_display }}</span></div>
                    <div data-label="Ср. чек"><span class="cust-num">{{ row.avg_display }}</span></div>
                    <div data-label="Последний">
                        {% if row.last_order_date %}{{ row.last_order_date|date:"d.m.Y" }}{% else %}<span class="cust-num muted">—</span>{% endif %}
                    </div>
                    <div data-label="Статус" class="cust-sources">
                        <span class="fc-badge {{ row.status_class }}">{{ row.status_label }}</span>
                        {% if row.is_corporate %}<span class="fc-badge fc-badge-amber">Корп.</span>{% endif %}
                        {% if row.ordered_lunches %}<span class="fc-badge fc-badge-green" title="Заказывал обеды">🍱</span>{% endif %}
                        {% if row.blocked %}<span class="fc-badge fc-badge-red">⚠ Отказ</span>{% endif %}
                    </div>
                    <div data-label="Источник" class="cust-sources">
                        {% for b in row.source_badges %}
                            <span class="fc-badge {{ b.cls }}">{{ b.label }}</span>
                        {% empty %}
                            <span class="cust-num muted">—</span>
                        {% endfor %}
                    </div>
                </div>
            {% empty %}
                <div class="fc-empty">
                    <div class="fc-empty-title">Клиенты не найдены</div>
                    <div class="fc-empty-sub">Измените фильтры или сбросьте их.</div>
                </div>
            {% endfor %}
        </div>

        {% if page_obj.paginator.num_pages > 1 %}
            <div class="fc-pagination">
                <div class="info">Страница {{ page_obj.number }} из {{ page_obj.paginator.num_pages }}</div>
                <div class="pages">
                    {% if page_obj.has_previous %}
                        <a class="fc-btn fc-btn-secondary fc-btn-sm" href="?{% if base_qs %}{{ base_qs }}&{% endif %}page={{ page_obj.previous_page_number }}">← Назад</a>
                    {% else %}
                        <span class="fc-btn fc-btn-secondary fc-btn-sm disabled">← Назад</span>
                    {% endif %}
                    {% if page_obj.has_next %}
                        <a class="fc-btn fc-btn-secondary fc-btn-sm" href="?{% if base_qs %}{{ base_qs }}&{% endif %}page={{ page_obj.next_page_number }}">Вперёд →</a>
                    {% else %}
                        <span class="fc-btn fc-btn-secondary fc-btn-sm disabled">Вперёд →</span>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </div>

</div>
</div>

<script>
function toggleNewCust(){
  var c=document.getElementById('newCustCard');
  if(c){ c.style.display=(c.style.display==='none'||!c.style.display)?'block':'none'; }
}
</script>
{% endblock %}
