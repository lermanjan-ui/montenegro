{% extends "foodcost/base.html" %}
{% block title %}Мой профиль · {{ country.name }}{% endblock %}
{% block content %}
<style>
.ac-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:16px;align-items:start;}
.ac-row{display:flex;justify-content:space-between;gap:16px;padding:11px 0;border-bottom:1px solid var(--border);}
.ac-row:last-child{border-bottom:0;}
.ac-row .k{color:var(--muted);font-weight:500;}
.ac-row .v{font-weight:600;text-align:right;}
.ac-chips{display:flex;flex-wrap:wrap;gap:6px;justify-content:flex-end;max-width:60%;}
.ac-chip{font-size:12px;font-weight:600;background:var(--primary-soft);color:var(--primary);padding:3px 9px;border-radius:999px;}
.ac-field{margin-bottom:12px;}
.ac-field label{display:block;font-weight:600;font-size:13px;margin:0 0 6px;}
.ac-field input{width:100%;height:40px;border:1px solid var(--border);border-radius:8px;padding:0 12px;font-family:inherit;font-size:14px;background:#fff;}
.ac-ok{background:var(--green-soft);color:var(--primary);border-radius:8px;padding:10px 14px;margin-bottom:14px;font-weight:600;}
.ac-err{background:var(--danger-soft);color:var(--danger);border-radius:8px;padding:10px 14px;margin-bottom:14px;font-weight:600;}
.ac-note{color:var(--muted);font-size:12px;margin:-4px 0 12px;}
@media(max-width:820px){.ac-grid{grid-template-columns:1fr;}}
</style>

<h1 style="margin:0 0 4px;">Мой профиль</h1>
<div style="color:var(--muted);margin-bottom:16px;">Компания: {{ country.name }}</div>

{% if saved == "login" %}<div class="ac-ok">Логин сохранён.</div>{% endif %}
{% if saved == "password" %}<div class="ac-ok">Пароль сохранён.</div>{% endif %}
{% if error %}<div class="ac-err">{{ error }}</div>{% endif %}

<div class="ac-grid">
  <!-- Инфо -->
  <div class="card">
    <h2 style="margin-top:0;">Учётная запись</h2>
    <div class="ac-row"><span class="k">Логин</span><span class="v">{{ request.user.username }}</span></div>
    <div class="ac-row"><span class="k">Роль</span><span class="v">{{ role_label }}</span></div>
    <div class="ac-row"><span class="k">Филиал</span><span class="v">{{ branch|default:"— не задан —" }}</span></div>
    <div class="ac-row"><span class="k">Вход по паролю</span><span class="v">{% if has_password %}включён{% else %}не задан{% endif %}</span></div>
    <div class="ac-row">
      <span class="k">Доступные разделы</span>
      <span class="ac-chips">
        {% for s in sections %}<span class="ac-chip">{{ s }}</span>{% empty %}<span class="v" style="color:var(--muted);font-weight:500;">нет доступов</span>{% endfor %}
      </span>
    </div>
  </div>

  <div>
    <!-- Логин -->
    <div class="card">
      <h2 style="margin-top:0;">Логин для входа</h2>
      <p class="ac-note">Логин нужен для входа по паролю (помимо входа по коду).</p>
      <form method="post">
        {% csrf_token %}
        <input type="hidden" name="action" value="set_login">
        <div class="ac-field">
          <label>Логин</label>
          <input type="text" name="login" value="{{ request.user.username }}" autocomplete="username" required>
        </div>
        <button type="submit">Сохранить логин</button>
      </form>
    </div>

    <!-- Пароль -->
    <div class="card">
      <h2 style="margin-top:0;">{% if has_password %}Сменить пароль{% else %}Задать пароль{% endif %}</h2>
      {% if not has_password %}<p class="ac-note">Сейчас вход только по коду. Задайте пароль, чтобы входить и по паролю.</p>{% endif %}
      <form method="post">
        {% csrf_token %}
        <input type="hidden" name="action" value="change_password">
        {% if has_password %}
        <div class="ac-field">
          <label>Текущий пароль</label>
          <input type="password" name="old_password" autocomplete="current-password" required>
        </div>
        {% endif %}
        <div class="ac-field">
          <label>Новый пароль</label>
          <input type="password" name="new_password" autocomplete="new-password" required>
        </div>
        <div class="ac-field">
          <label>Повторите новый пароль</label>
          <input type="password" name="new_password2" autocomplete="new-password" required>
        </div>
        <button type="submit">{% if has_password %}Сменить пароль{% else %}Задать пароль{% endif %}</button>
      </form>
    </div>
  </div>
</div>
{% endblock %}
