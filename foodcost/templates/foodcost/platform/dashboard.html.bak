{% extends "foodcost/platform/base.html" %}
{% block title %}Клиенты · Платформа{% endblock %}
{% block content %}
<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap;">
  <div>
    <h1>Клиенты</h1>
    <p class="sub">Арендаторы платформы, их тарифы и активность.</p>
  </div>
  <a class="btn" href="/platform/clients/new/">+ Новый клиент</a>
</div>

<div class="card">
  <div class="stat-grid">
    <div class="stat"><div class="n">{{ totals.clients }}</div><div class="l">Всего клиентов</div></div>
    <div class="stat"><div class="n">{{ totals.active }}</div><div class="l">Активные</div></div>
    <div class="stat"><div class="n">{{ totals.trial }}</div><div class="l">Триал</div></div>
    <div class="stat"><div class="n">{{ totals.suspended }}</div><div class="l">Приостановлены</div></div>
    <div class="stat"><div class="n">{{ totals.orders_30d }}</div><div class="l">Заказов за 30 дней</div></div>
  </div>
</div>

<div class="card" style="padding:0;overflow:hidden;">
  <table>
    <thead>
      <tr>
        <th>Клиент</th>
        <th>Тариф</th>
        <th>Статус</th>
        <th>Модулей</th>
        <th>Филиалов</th>
        <th>Заказов (30д / всего)</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {% for x in clients %}
      <tr>
        <td>
          <div style="font-weight:600;">{{ x.country.name }}</div>
          <div class="muted" style="font-size:12px;">/{{ x.country.slug }}</div>
        </td>
        <td>{{ x.plan_name }}</td>
        <td>
          {% if x.status == "active" %}<span class="badge ok">{{ x.status_label }}</span>
          {% elif x.status == "trial" %}<span class="badge warn">{{ x.status_label }}</span>
          {% elif x.status == "suspended" %}<span class="badge off">{{ x.status_label }}</span>
          {% elif x.status == "cancelled" %}<span class="badge off">{{ x.status_label }}</span>
          {% else %}<span class="badge neutral">{{ x.status_label }}</span>{% endif %}
        </td>
        <td>{% if x.module_count is None %}<span class="muted">без лимита</span>{% else %}{{ x.module_count }}{% endif %}</td>
        <td>{{ x.locations }}</td>
        <td>{{ x.orders_30d }} / {{ x.orders_total }}</td>
        <td style="text-align:right;white-space:nowrap;">
          <a class="btn sec sm" href="/platform/clients/{{ x.country.slug }}/">Открыть</a>
        </td>
      </tr>
      {% empty %}
      <tr><td colspan="7" class="muted" style="padding:24px;text-align:center;">Клиентов пока нет.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
