<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Подтверждение · FoodCost</title>
  <style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
:root{--bg:#F7F8FA;--text:#111827;--muted:#667085;--border:#E5E7EB;--primary:#123B7A;--primary-dark:#0D2D5F;--primary-soft:#E7EDF7;--danger:#E23B3B;--danger-soft:#FDECEC;--ok-soft:#E6F4EC;--ok:#157347;}
*{box-sizing:border-box;}
body{font-family:Inter,system-ui,sans-serif;background:var(--bg);margin:0;color:var(--text);font-size:14px;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;}
.wrap{width:100%;max-width:400px;}
.brand{font-size:20px;font-weight:700;margin-bottom:10px;}
.card{background:#fff;border:1px solid var(--border);border-radius:12px;padding:24px;text-align:center;}
.card h1{font-size:20px;margin:0 0 6px;}
.card p{color:var(--muted);margin:0 0 18px;}
input{width:100%;height:52px;border:1px solid var(--border);border-radius:8px;padding:0 12px;font-family:inherit;font-size:22px;text-align:center;letter-spacing:8px;font-weight:700;}
input:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px var(--primary-soft);}
.btn{width:100%;height:46px;background:var(--primary);color:#fff;border:0;border-radius:8px;font-weight:600;cursor:pointer;font-size:15px;margin-top:16px;}
.btn:hover{background:var(--primary-dark);}
.err{background:var(--danger-soft);color:var(--danger);border-radius:8px;padding:10px 14px;margin-bottom:14px;font-weight:600;}
.debug{background:var(--ok-soft);color:var(--ok);border-radius:8px;padding:10px 14px;margin-bottom:14px;font-weight:600;}
.foot{text-align:center;color:var(--muted);margin-top:14px;font-size:13px;}
.foot a{color:var(--primary);text-decoration:none;font-weight:600;}
  </style>
</head>
<body>
  <div class="wrap">
    <div class="brand">FoodCost</div>
    <div class="card">
      <h1>Введите код</h1>
      <p>Мы отправили код подтверждения на<br><b>{{ target }}</b></p>
      {% if debug_code %}<div class="debug">Код (режим разработки): {{ debug_code }}</div>{% endif %}
      {% if error %}<div class="err">{{ error }}</div>{% endif %}
      <form method="post">
        {% csrf_token %}
        <input type="text" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" autofocus placeholder="• • • • •">
        <button class="btn" type="submit">Подтвердить и создать аккаунт</button>
      </form>
    </div>
    <div class="foot"><a href="/signup/">← Изменить данные</a></div>
  </div>
</body>
</html>
