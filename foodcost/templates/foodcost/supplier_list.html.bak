{% extends "foodcost/base.html" %}

{% block title %}Поставщики{% endblock %}

{% block content %}

<!-- CSS inline (без staticfiles). FoodCost UI Kit v2. Список поставщиков:
     KPI, фильтры, таблица, инлайн-редактирование (.edit-btn → .sup-card.editing),
     создание, архивация. Удаление не предусмотрено — только архивация. -->
<style>
:root{
    --fc-bg:#F5F7FA; --fc-card:#FFFFFF; --fc-card-soft:#F9FAFB;
    --fc-border:#E5E7EB; --fc-border-soft:#F3F4F6;
    --fc-text:#111827; --fc-muted:#6B7280; --fc-muted-soft:#9CA3AF;
    --fc-green:#16A34A; --fc-green-hover:#15803D; --fc-green-soft:#DCFCE7; --fc-green-text:#166534;
    --fc-amber:#F59E0B; --fc-amber-soft:#FEF3C7; --fc-amber-text:#92400E;
    --fc-danger:#EF4444; --fc-danger-hover:#DC2626; --fc-danger-soft:#FEE2E2; --fc-danger-text:#991B1B;
    --fc-info:#3B82F6; --fc-info-soft:#DBEAFE; --fc-info-text:#1E40AF;
    --fc-radius-card:12px; --fc-radius-input:10px; --fc-radius-pill:999px;
    --fc-shadow:0 1px 2px rgba(0,0,0,.04), 0 4px 12px rgba(0,0,0,.04);
    --fc-font:"Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}
.fc-scope{ background:var(--fc-bg); color:var(--fc-text); font-family:var(--fc-font); min-height:100vh; }
.fc-scope *{ box-sizing:border-box; }
.fc-page{ max-width:1320px; margin:0 auto; padding:24px; }

.fc-page-head{ display:flex; justify-content:space-between; align-items:flex-start; gap:16px; margin-bottom:20px; flex-wrap:wrap; }
.fc-page-head h1{ margin:0 0 6px; font-size:30px; font-weight:600; letter-spacing:-0.02em; }
.muted{ color:var(--fc-muted); font-size:14px; margin:0; }

.fc-card{ background:var(--fc-card); border:1px solid var(--fc-border); border-radius:var(--fc-radius-card); box-shadow:var(--fc-shadow); padding:20px; margin-bottom:16px; }
.fc-card h2{ margin:0 0 16px; font-size:20px; font-weight:600; }

.kpi-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:16px; }
.kpi{ background:var(--fc-card); border:1px solid var(--fc-border); border-radius:var(--fc-radius-card); box-shadow:var(--fc-shadow); padding:18px; }
.kpi-ico{ width:38px; height:38px; border-radius:10px; display:flex; align-items:center; justify-content:center; margin-bottom:10px; }
.kpi-ico svg{ width:20px; height:20px; }
.kpi-label{ color:var(--fc-muted); font-size:13px; font-weight:600; margin-bottom:4px; }
.kpi-value{ font-size:26px; font-weight:700; letter-spacing:-0.01em; }
.kpi-sub{ color:var(--fc-muted-soft); font-size:12px; margin-top:2px; }
.ico-info{ background:var(--fc-info-soft); color:var(--fc-info-text); }
.ico-green{ background:var(--fc-green-soft); color:var(--fc-green-text); }
.ico-amber{ background:var(--fc-amber-soft); color:var(--fc-amber-text); }
.ico-danger{ background:var(--fc-danger-soft); color:var(--fc-danger-text); }

.filters{ display:grid; grid-template-columns:2fr 1fr 1fr auto; gap:14px; align-items:end; }
.fc-label{ display:block; font-size:13px; font-weight:600; margin-bottom:6px; }
.fc-input,.fc-select,.fc-textarea{ width:100%; height:40px; padding:0 12px; background:var(--fc-card); border:1px solid var(--fc-border); border-radius:var(--fc-radius-input); font-family:inherit; font-size:14px; color:var(--fc-text); }
.fc-textarea{ height:auto; min-height:64px; padding:10px 12px; }
.fc-input:focus,.fc-select:focus,.fc-textarea:focus{ outline:none; border-color:var(--fc-green); box-shadow:0 0 0 3px rgba(22,163,74,.12); }
.filter-actions{ display:flex; gap:10px; }

.fc-btn{ display:inline-flex; align-items:center; justify-content:center; gap:8px; height:40px; padding:0 16px; border-radius:var(--fc-radius-input); border:1px solid transparent; font-family:inherit; font-size:14px; font-weight:600; cursor:pointer; text-decoration:none; white-space:nowrap; }
.fc-btn-primary{ background:var(--fc-green); color:#fff; }
.fc-btn-primary:hover{ background:var(--fc-green-hover); }
.fc-btn-dark{ background:var(--fc-text); color:#fff; }
.fc-btn-secondary{ background:var(--fc-card); color:var(--fc-text); border-color:var(--fc-border); }
.fc-btn-secondary:hover{ border-color:var(--fc-text); }
.fc-btn-danger{ background:var(--fc-card); color:var(--fc-danger-text); border-color:#FCA5A5; }
.fc-btn-danger:hover{ background:var(--fc-danger-soft); }
.fc-btn-sm{ height:34px; padding:0 12px; font-size:13px; }

.fc-table{ border:1px solid var(--fc-border); border-radius:var(--fc-radius-card); overflow:hidden; }
.t-head,.t-row{ display:grid; gap:12px; align-items:center; padding:13px 16px;
    grid-template-columns: minmax(150px,1.6fr) 1.2fr 1.3fr 70px 70px 1fr 1.1fr 0.9fr auto; }
.t-head{ background:var(--fc-card-soft); border-bottom:1px solid var(--fc-border); font-size:12px; font-weight:600; color:var(--fc-muted); text-transform:uppercase; letter-spacing:.04em; }
.sup-card{ border-bottom:1px solid var(--fc-border-soft); }
.sup-card:last-child{ border-bottom:0; }
.t-row:hover{ background:var(--fc-card-soft); }
.s-name{ font-weight:600; }
.s-phone{ white-space:pre-line; font-size:13px; color:var(--fc-text); }
.num{ font-variant-numeric:tabular-nums; }
.debt-red{ color:var(--fc-danger-text); font-weight:600; }
.row-actions{ display:flex; gap:6px; justify-self:end; }

.badge{ display:inline-flex; align-items:center; gap:5px; padding:3px 11px; border-radius:var(--fc-radius-pill); font-size:12px; font-weight:600; white-space:nowrap; }
.badge-green{ background:var(--fc-green-soft); color:var(--fc-green-text); }
.badge-gray{ background:var(--fc-border-soft); color:var(--fc-muted); }

.edit-panel{ display:none; padding:18px; background:var(--fc-card-soft); border-top:1px solid var(--fc-border); }
.sup-card.editing .edit-panel{ display:block; }
.form-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-bottom:14px; }
.edit-actions{ display:flex; gap:10px; justify-content:flex-end; }

.t-foot{ display:flex; justify-content:space-between; align-items:center; gap:12px; margin-top:14px; flex-wrap:wrap; }
.pager{ display:flex; gap:6px; align-items:center; }
.pager a,.pager span{ min-width:36px; height:36px; padding:0 10px; display:inline-flex; align-items:center; justify-content:center; border:1px solid var(--fc-border); border-radius:8px; text-decoration:none; color:var(--fc-text); font-size:14px; font-weight:600; }
.pager .cur{ background:var(--fc-text); color:#fff; border-color:var(--fc-text); }
.pager .disabled{ color:var(--fc-muted-soft); pointer-events:none; opacity:.5; }
.empty{ text-align:center; padding:36px 16px; color:var(--fc-muted); font-size:14px; }

@media (max-width:1024px){
    .kpi-grid{ grid-template-columns:1fr 1fr; }
    .filters{ grid-template-columns:1fr 1fr; }
    .form-grid{ grid-template-columns:1fr 1fr; }
    .t-head{ display:none; }
    .t-row{ grid-template-columns:1fr 1fr; }
}
@media (max-width:560px){
    .fc-page{ padding:16px; }
    .kpi-grid,.filters,.form-grid,.t-row{ grid-template-columns:1fr; }
}
</style>

<div class="fc-scope">
<div class="fc-page">

    <div class="fc-page-head">
        <div>
            <h1>Поставщики</h1>
            <p class="muted">Управление поставщиками и контроль закупок.</p>
        </div>
        {% if can_edit %}
            <a href="#create-supplier" class="fc-btn fc-btn-dark">+ Новый поставщик</a>
        {% endif %}
    </div>

    <!-- KPI -->
    <div class="kpi-grid">
        <div class="kpi">
            <div class="kpi-ico ico-info"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.9"/><path d="M16 3.1a4 4 0 0 1 0 7.8"/></svg></div>
            <div class="kpi-label">Всего поставщиков</div>
            <div class="kpi-value">{{ kpi_total }}</div>
            <div class="kpi-sub">всего</div>
        </div>
        <div class="kpi">
            <div class="kpi-ico ico-green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg></div>
            <div class="kpi-label">Активных поставщиков</div>
            <div class="kpi-value">{{ kpi_active }}</div>
            <div class="kpi-sub">is_active</div>
        </div>
        <div class="kpi">
            <div class="kpi-ico ico-amber"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div>
            <div class="kpi-label">Неоплаченные закупки</div>
            <div class="kpi-value">{{ kpi_unpaid_count }}</div>
            <div class="kpi-sub">приходов</div>
        </div>
        <div class="kpi">
            <div class="kpi-ico ico-danger"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M14.5 9a2.5 2 0 0 0-5 0c0 1.4 1 2 2.5 2.5s2.5 1.1 2.5 2.5a2.5 2 0 0 1-5 0"/><path d="M12 7v10"/></svg></div>
            <div class="kpi-label">Задолженность</div>
            <div class="kpi-value num">{{ kpi_debt_display }}</div>
            <div class="kpi-sub">сумма</div>
        </div>
    </div>

    <!-- Фильтры -->
    <div class="fc-card">
        <form method="get">
            <div class="filters">
                <div>
                    <label class="fc-label">Поиск</label>
                    <input class="fc-input" type="text" name="search" value="{{ search }}" placeholder="Название, контакт или телефон...">
                </div>
                <div>
                    <label class="fc-label">Статус</label>
                    <select class="fc-select" name="status">
                        <option value="">Все статусы</option>
                        <option value="active" {% if status == "active" %}selected{% endif %}>Активные</option>
                        <option value="inactive" {% if status == "inactive" %}selected{% endif %}>Неактивные</option>
                    </select>
                </div>
                <div>
                    <label class="fc-label">Есть задолженность</label>
                    <select class="fc-select" name="has_debt">
                        <option value="">Все</option>
                        <option value="yes" {% if has_debt == "yes" %}selected{% endif %}>Да</option>
                        <option value="no" {% if has_debt == "no" %}selected{% endif %}>Нет</option>
                    </select>
                </div>
                <div class="filter-actions">
                    <button type="submit" class="fc-btn fc-btn-primary">Применить</button>
                    <a href="/c/{{ country.slug }}/suppliers/" class="fc-btn fc-btn-secondary">Сбросить</a>
                </div>
            </div>
        </form>
    </div>

    <!-- Таблица -->
    <div class="fc-card">
        <div class="fc-table">
            <div class="t-head">
                <div>Название</div>
                <div>Контактное лицо</div>
                <div>Телефон</div>
                <div>Товаров</div>
                <div>Закупок</div>
                <div>Последняя закупка</div>
                <div>Задолженность</div>
                <div>Статус</div>
                <div></div>
            </div>

            {% for r in page_obj %}
            <div class="sup-card">
                <div class="t-row">
                    <div class="s-name">{{ r.name }}</div>
                    <div>{{ r.contact_person|default:"—" }}</div>
                    <div class="s-phone">{{ r.phone|default:"—" }}</div>
                    <div class="num">{{ r.products_count }}</div>
                    <div class="num">{{ r.purchases_count }}</div>
                    <div>{% if r.last_purchase %}{{ r.last_purchase|date:"d.m.Y" }}{% else %}<span class="muted">—</span>{% endif %}</div>
                    <div class="num {% if r.debt > 0 %}debt-red{% endif %}">{{ r.debt_display }}</div>
                    <div>
                        {% if r.is_active %}<span class="badge badge-green">Активный</span>{% else %}<span class="badge badge-gray">Неактивный</span>{% endif %}
                    </div>
                    <div class="row-actions">
                        <a href="/c/{{ country.slug }}/suppliers/{{ r.id }}/" class="fc-btn fc-btn-secondary fc-btn-sm">Открыть</a>
                        {% if can_edit %}
                            <button type="button" class="fc-btn fc-btn-secondary fc-btn-sm edit-btn">✎</button>
                            {% if r.is_active %}
                            <form method="post" onsubmit="return confirm('Архивировать поставщика «{{ r.name|escapejs }}»? Он перестанет быть активным, но история сохранится.');">
                                {% csrf_token %}
                                <input type="hidden" name="action" value="archive_supplier">
                                <input type="hidden" name="supplier_id" value="{{ r.id }}">
                                <button type="submit" class="fc-btn fc-btn-danger fc-btn-sm">Архив</button>
                            </form>
                            {% else %}
                            <form method="post">
                                {% csrf_token %}
                                <input type="hidden" name="action" value="unarchive_supplier">
                                <input type="hidden" name="supplier_id" value="{{ r.id }}">
                                <button type="submit" class="fc-btn fc-btn-secondary fc-btn-sm">Вернуть</button>
                            </form>
                            {% endif %}
                        {% else %}
                            <span class="muted">—</span>
                        {% endif %}
                    </div>
                </div>

                {% if can_edit %}
                <div class="edit-panel">
                    <form method="post">
                        {% csrf_token %}
                        <input type="hidden" name="action" value="update_supplier">
                        <input type="hidden" name="supplier_id" value="{{ r.id }}">
                        <div class="form-grid">
                            <div><label class="fc-label">Название *</label><input class="fc-input" name="name" value="{{ r.name }}" required></div>
                            <div><label class="fc-label">Контактное лицо</label><input class="fc-input" name="contact_person" value="{{ r.contact_person }}"></div>
                            <div><label class="fc-label">Telegram</label><input class="fc-input" name="telegram" value="{{ r.telegram }}"></div>
                            <div><label class="fc-label">Email</label><input class="fc-input" name="email" value="{{ r.email }}"></div>
                            <div style="grid-column:span 2;"><label class="fc-label">Телефоны (по одному в строке)</label><textarea class="fc-textarea" name="phone">{{ r.phone }}</textarea></div>
                            <div style="grid-column:span 3;"><label class="fc-label">Комментарий</label><textarea class="fc-textarea" name="comment">{{ r.comment }}</textarea></div>
                            <div><label class="fc-label">&nbsp;</label><label style="display:flex;align-items:center;gap:8px;height:40px;"><input type="checkbox" name="is_active" {% if r.is_active %}checked{% endif %} style="width:17px;height:17px;accent-color:var(--fc-green);"> Активен</label></div>
                        </div>
                        <div class="edit-actions">
                            <button type="button" class="fc-btn fc-btn-secondary cancel-edit-btn">Отмена</button>
                            <button type="submit" class="fc-btn fc-btn-primary">Сохранить</button>
                        </div>
                    </form>
                </div>
                {% endif %}
            </div>
            {% empty %}
                <div class="empty">Поставщиков пока нет.{% if can_edit %} Создайте первого ниже.{% endif %}</div>
            {% endfor %}
        </div>

        <div class="t-foot">
            <div class="muted">
                {% if total_count %}Показано {{ page_obj.start_index }}–{{ page_obj.end_index }} из {{ total_count }}{% else %}Ничего не найдено{% endif %}
            </div>
            {% if page_obj.paginator.num_pages > 1 %}
            <div class="pager">
                {% if page_obj.has_previous %}<a href="?page={{ page_obj.previous_page_number }}{{ base_qs }}">‹</a>{% else %}<span class="disabled">‹</span>{% endif %}
                {% for n in page_obj.paginator.page_range %}
                    {% if n == page_obj.number %}<span class="cur">{{ n }}</span>
                    {% elif n > page_obj.number|add:'-3' and n < page_obj.number|add:'3' %}<a href="?page={{ n }}{{ base_qs }}">{{ n }}</a>{% endif %}
                {% endfor %}
                {% if page_obj.has_next %}<a href="?page={{ page_obj.next_page_number }}{{ base_qs }}">›</a>{% else %}<span class="disabled">›</span>{% endif %}
            </div>
            {% endif %}
            <form method="get" style="display:flex;align-items:center;gap:8px;">
                {% if search %}<input type="hidden" name="search" value="{{ search }}">{% endif %}
                {% if status %}<input type="hidden" name="status" value="{{ status }}">{% endif %}
                {% if has_debt %}<input type="hidden" name="has_debt" value="{{ has_debt }}">{% endif %}
                <span class="muted">На странице</span>
                <select class="fc-select" name="per_page" onchange="this.form.submit()" style="width:auto;height:36px;">
                    <option value="25" {% if per_page == 25 %}selected{% endif %}>25</option>
                    <option value="50" {% if per_page == 50 %}selected{% endif %}>50</option>
                    <option value="100" {% if per_page == 100 %}selected{% endif %}>100</option>
                </select>
            </form>
        </div>
    </div>

    <!-- Создать поставщика -->
    {% if can_edit %}
    <div class="fc-card" id="create-supplier">
        <h2>Новый поставщик</h2>
        <form method="post">
            {% csrf_token %}
            <input type="hidden" name="action" value="create_supplier">
            <div class="form-grid">
                <div><label class="fc-label">Название *</label><input class="fc-input" name="name" placeholder="Например: Asia Foods" required></div>
                <div><label class="fc-label">Контактное лицо</label><input class="fc-input" name="contact_person" placeholder="Иван Петров"></div>
                <div><label class="fc-label">Telegram</label><input class="fc-input" name="telegram" placeholder="@asia_foods"></div>
                <div><label class="fc-label">Email</label><input class="fc-input" name="email" placeholder="info@asiafoods.uz"></div>
                <div style="grid-column:span 2;"><label class="fc-label">Телефоны (по одному в строке)</label><textarea class="fc-textarea" name="phone" placeholder="+998 90 123 45 67&#10;+998 99 123 45 67"></textarea></div>
                <div style="grid-column:span 3;"><label class="fc-label">Комментарий</label><textarea class="fc-textarea" name="comment" placeholder="Необязательно"></textarea></div>
                <div><label class="fc-label">&nbsp;</label><label style="display:flex;align-items:center;gap:8px;height:40px;"><input type="checkbox" name="is_active" checked style="width:17px;height:17px;accent-color:var(--fc-green);"> Активен</label></div>
            </div>
            <div class="edit-actions">
                <button type="submit" class="fc-btn fc-btn-primary">Создать поставщика</button>
            </div>
        </form>
    </div>
    {% endif %}

</div>
</div>

<script>
document.addEventListener("click", function(e){
    const editBtn = e.target.closest(".edit-btn");
    if (editBtn){ e.preventDefault(); editBtn.closest(".sup-card").classList.toggle("editing"); return; }
    const cancelBtn = e.target.closest(".cancel-edit-btn");
    if (cancelBtn){ e.preventDefault(); cancelBtn.closest(".sup-card").classList.remove("editing"); }
});
</script>

{% endblock %}
