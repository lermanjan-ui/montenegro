{% extends "foodcost/base.html" %}

{% block title %}Аналитика списаний{% endblock %}

{% block content %}

<style>
    .page { max-width: 1400px; margin: 0 auto; }

    .muted { color:#6b7280; font-size:14px; }

    h1 {
        margin:0 0 8px;
        font-size:36px;
        color:#111827;
        letter-spacing:-0.03em;
    }

    h2 {
        margin:0 0 18px;
        font-size:24px;
        color:#111827;
    }

    .filters {
        display:grid;
        grid-template-columns: repeat(4, 1fr) 140px;
        gap:12px;
        align-items:end;
    }

    label {
        display:block;
        margin-bottom:6px;
        font-size:13px;
        font-weight:900;
        color:#111827;
    }

    input, select {
        width:100%;
        padding:11px 12px;
        border-radius:12px;
        border:1px solid #d1d5db;
        box-sizing:border-box;
        background:white;
        font-size:14px;
    }

    button {
        background:#111827;
        color:white;
        border:0;
        border-radius:12px;
        padding:12px 16px;
        font-weight:900;
        cursor:pointer;
    }

    .stats {
        display:grid;
        grid-template-columns:repeat(3, 1fr);
        gap:14px;
    }

    .metric {
        background:#f8fafc;
        border:1px solid #e5e7eb;
        border-radius:16px;
        padding:18px;
    }

    .metric span {
        display:block;
        color:#6b7280;
        font-size:13px;
        font-weight:900;
        margin-bottom:8px;
    }

    .metric b {
        display:block;
        font-size:30px;
        line-height:1.1;
        color:#111827;
    }

    .metric.danger b { color:#b91c1c; }
    .metric.green b { color:#047857; }

    .table-wrap {
        border:1px solid #e5e7eb;
        border-radius:14px;
        overflow:hidden;
        background:white;
    }

    table {
        width:100%;
        border-collapse:collapse;
    }

    th {
        background:#111827;
        color:white;
        padding:14px;
        text-align:left;
        font-size:13px;
        font-weight:900;
    }

    td {
        padding:14px;
        border-bottom:1px solid #eef2f7;
        vertical-align:middle;
        font-size:14px;
    }

    tr:last-child td { border-bottom:0; }

    .badge {
        display:inline-flex;
        background:#f3f4f6;
        color:#374151;
        border-radius:999px;
        padding:6px 10px;
        font-size:12px;
        font-weight:900;
        white-space:nowrap;
    }

    .reason {
        display:inline-flex;
        background:#ecfdf5;
        color:#047857;
        border-radius:999px;
        padding:6px 10px;
        font-size:12px;
        font-weight:900;
        white-space:nowrap;
    }

    .price {
        color:#b91c1c;
        font-weight:950;
        white-space:nowrap;
    }

    .item-name {
        font-weight:950;
        color:#111827;
    }

    .empty {
        padding:22px;
        color:#6b7280;
        font-weight:800;
    }

    .filter-actions {
        display:flex;
        gap:10px;
        align-items:center;
    }

    .reset-link {
        color:#374151;
        text-decoration:none;
        font-weight:900;
        padding:12px 14px;
        border-radius:12px;
        background:#f3f4f6;
        white-space:nowrap;
    }

    @media (max-width:1100px) {
        .filters,
        .stats {
            grid-template-columns:1fr;
        }

        .table-wrap {
            overflow-x:auto;
        }

        table {
            min-width:1000px;
        }
    }
</style>

<div class="page">

<div class="card">
    <h1>Аналитика списаний</h1>
    <div class="muted">Фильтры пересчитывают показатели и таблицу ниже.</div>
</div>

<div class="card">
    <form method="get">
        <div class="filters">
            <div>
                <label>Дата от</label>
                <input type="date" name="date_from" value="{{ date_from }}">
            </div>

            <div>
                <label>Дата до</label>
                <input type="date" name="date_to" value="{{ date_to }}">
            </div>

            <div>
                <label>Тип позиции</label>
                <select name="item_type">
                    <option value="">Все</option>
                    <option value="product" {% if item_type == "product" %}selected{% endif %}>Продукты</option>
                    <option value="preparation" {% if item_type == "preparation" %}selected{% endif %}>Заготовки</option>
                </select>
            </div>

            <div>
                <label>Причина</label>
                <select name="reason">
                    <option value="">Все</option>
                    {% for value, label in reasons %}
                        <option value="{{ value }}" {% if reason == value %}selected{% endif %}>{{ label }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="filter-actions">
                <button type="submit">Применить</button>
            </div>

            <div>
                <label>Продукт</label>
                <select name="product_id">
                    <option value="">Все</option>
                    {% for product in products %}
                        <option value="{{ product.id }}" {% if product_id == product.id|stringformat:"s" %}selected{% endif %}>
                            {{ product.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div>
                <label>Заготовка</label>
                <select name="preparation_id">
                    <option value="">Все</option>
                    {% for preparation in preparations %}
                        <option value="{{ preparation.id }}" {% if preparation_id == preparation.id|stringformat:"s" %}selected{% endif %}>
                            {{ preparation.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div>
                <label>Сотрудник</label>
                <select name="user_id">
                    <option value="">Все</option>
                    {% for user in users %}
                        <option value="{{ user.id }}" {% if user_id == user.id|stringformat:"s" %}selected{% endif %}>
                            {{ user.username }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div></div>

            <div class="filter-actions">
                <a class="reset-link" href="/c/{{ country.slug }}/writeoffs/analytics/">Сбросить</a>
            </div>
        </div>
    </form>
</div>

<div class="card">
    <div class="stats">
        <div class="metric danger">
            <span>Общая сумма списаний</span>
            <b>{{ total_cost|floatformat:0 }}</b>
        </div>

        <div class="metric">
            <span>Количество списаний</span>
            <b>{{ writeoffs.count }}</b>
        </div>

        <div class="metric green">
            <span>Период</span>
            <b>{{ date_from }}</b>
            <div class="muted">до {{ date_to }}</div>
        </div>
    </div>
</div>

<div class="card">
    <h2>Списания за выбранный период</h2>

    <div class="table-wrap">
        <table>
            <tr>
                <th>Дата</th>
                <th>Тип</th>
                <th>Позиция</th>
                <th>Кол-во</th>
                <th>Причина</th>
                <th>Комментарий</th>
                <th>Сотрудник</th>
                <th>Стоимость</th>
            </tr>

            {% for item in writeoffs %}
            <tr>
                <td>{{ item.writeoff_date }}</td>

                <td>
                    <span class="badge">{{ item.get_item_type_display }}</span>
                </td>

                <td>
                    <span class="item-name">
                        {% if item.product %}
                            {{ item.product.name }}
                        {% elif item.preparation %}
                            {{ item.preparation.name }}
                        {% else %}
                            —
                        {% endif %}
                    </span>
                </td>

                <td>{{ item.quantity }}</td>

                <td>
                    <span class="reason">{{ item.get_reason_display }}</span>
                </td>

                <td>{{ item.comment|default:"—" }}</td>

                <td>
                    {% if item.created_by %}
                        {{ item.created_by.username }}
                    {% else %}
                        —
                    {% endif %}
                </td>

                <td class="price">{{ item.cost|floatformat:0 }}</td>
            </tr>
            {% empty %}
            <tr>
                <td colspan="8">
                    <div class="empty">Списаний по выбранным фильтрам нет</div>
                </td>
            </tr>
            {% endfor %}
        </table>
    </div>
</div>

</div>

{% endblock %}